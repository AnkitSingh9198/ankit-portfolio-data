# Public URL of the deployed site — used for canonical URL, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: Formspree form ID (e.g. "xayzabcd") so the contact form sends messages directly.
# Create a free form at https://formspree.io and paste the ID here.
# Formspree IDs are public by design (they are visible in any HTML form), so NEXT_PUBLIC is safe.
# If left empty, the form opens the visitor's email app with the message pre-filled instead.
NEXT_PUBLIC_FORMSPREE_ID=
